/*******************************************************************
 * File:        fsentries
 * Purpose:     Declares the fsentry_* functions which implement the
 *              filing system's response to each FileSwitch entry
 *              point. They are called, one parameter structure
 *              pointer per call, by the assembler veneers declared
 *              in h.interface (implemented in s.interface); you
 *              should not call them directly yourself. See the full
 *              prologue for each function in the .c file named
 *              below, and prminxml/fsinc.xml for the full
 *              description of each entry point and its reason codes.
 * Author:      YOUR NAME HERE
 * Date:        07 Aug 2026
 ******************************************************************/

#ifndef __DUMMYFSFSENTRIES_H
#define __DUMMYFSFSENTRIES_H

/* fsentry_open (c._open): open a file, directory, or other object
   for access, or create one if the reason code requires it. */
extern _kernel_oserror *fsentry_open(FSEntry_Open_Parameter *);

/* fsentry_getbytes (c._getbytes): read one byte, or a block of
   bytes, from an open file. */
extern _kernel_oserror *fsentry_getbytes(FSEntry_GetBytes_Parameter *);

/* fsentry_putbytes (c._putbytes): write one byte, or a block of
   bytes, to an open file. */
extern _kernel_oserror *fsentry_putbytes(FSEntry_PutBytes_Parameter *);

/* fsentry_args (c._args): miscellaneous operations on an
   already-open file. */
extern _kernel_oserror *fsentry_args(FSEntry_Args_Parameter *);

/* fsentry_close (c._close): close a previously-opened file. */
extern _kernel_oserror *fsentry_close(FSEntry_Close_Parameter *);

/* fsentry_file (c._file): whole-object operations identified by
   pathname rather than by an open handle. */
extern _kernel_oserror *fsentry_file(FSEntry_File_Parameter *);

/* fsentry_func (c._func): directory, path and filing-system-wide
   operations. */
extern _kernel_oserror *fsentry_func(FSEntry_Func_Parameter *);

/* fsentry_gbpb (c._gbpb): multiple-byte transfer to/from an
   already-open file at an explicit offset. */
extern _kernel_oserror *fsentry_gbpb(FSEntry_GBPB_Parameter *);
#endif
