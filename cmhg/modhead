; CMHG file for the dummy filesystem
;

#include "VersionNum"

#include "riscos/Services.h"

initialisation-code: dummyfs_initialise

; Always give the service numbers that you are interested in receiving.
service-call-handler: dummyfs_service \
                      Service_FSRedeclare

title-string: DummyFS

help-string: DummyFS Module_MajorVersion_CMHG Development Version

; When writing your own filing systm DO NOT USE THIS SWI CHUNK as it
; has already been used.
swi-chunk-base-number: 0x410C0

swi-handler-code: dummyfs_swi

swi-decoding-table: DummyFS,
                    DoNothing

command-keyword-table: dummyfs_command

        DummyFS(min-args:0, max-args:0,
                help-text: "*DummyFS selects DummyFS as the current filing system.\r",
                invalid-syntax: "Syntax:\t*DummyFS",
                add-syntax: )

; Register a different error base for your module - DO NOT USE THIS BASE.
error-base: &12100

; Add any error identifiers that you wish to use here. Errors are numbered
; sequentially from the error base, in the order they are listed:
;   err_NoMemory       = error-base + 0
;   err_BadParameters  = error-base + 1
;   err_DoesNothing    = error-base + 2
;   err_NoMedium       = error-base + 3
;   err_WriteProtected = error-base + 4
error-identifiers: err_NoMemory("Not enough free memory"),
                   err_BadParameters("Bad parameters passed internally"),
                   err_DoesNothing("This dummy filing system does nothing"),
                   err_NoMedium("No medium present"),
                   err_WriteProtected("Medium is write protected")
