; Error blocks for RISC OS NFS

        EXPORT  mb_malloc_failed
        EXPORT  mb_nfserr_BadParameters
        EXPORT  mb_nfserr_DummyFSDoesNothing

        AREA    |C$$data|
mb_malloc_failed
        DCD     &012100
        DCB     "Not enough free memory", 0,0

mb_nfserr_BadParameters
        DCD     &012101
        DCB     "Bad parameters passed internally", 0,0,0,0

mb_nfserr_DummyFSDoesNothing
        DCD     &012102
        DCB     "This dummy filing system does nothing", 0,0,0

        END

