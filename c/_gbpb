/*
        Implementation of the FSEntry_GBPB entry point. See the
        prologue for fsentry_gbpb in h.fsentries for the parameters
        and return convention, and prminxml/fsinc.xml for the full
        description of each reason code.
*/

#ifndef __DUMMYFSDUMMYFS_H
#include "dummyfs.h"
#endif

/*
        Multiple-byte transfer to/from an open file, selected by
        parm->reason. See h.fsentries for the parameter block layout.
        This entry point is only used when fsentry_open reported
        unbuffered GBPB support in the returned information word.
        parm->handle (R1), parm->address (R2) and parm->number (R3)
        are meaningful for every reason code below; on exit, update
        parm->address, parm->number (remaining, unwritten/unread
        byte count - zero if the whole transfer completed) and
        parm->sequential_file_pointer to reflect the transfer
        actually made.
*/
_kernel_oserror *fsentry_gbpb(FSEntry_GBPB_Parameter * parm)
{
    _kernel_oserror *err;

    switch (parm->reason)
    {
        case FSEntry_GBPB_Reason_PutMultipleBytesHere:
            /*
               parm->sequential_file_pointer (R4) gives the file
               offset to write at. Write parm->number (R3) bytes from
               parm->address (R2) to that offset.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_GBPB_Reason_PutMultipleBytes:
            /*
               Write parm->number (R3) bytes from parm->address (R2)
               at the file's current sequential pointer, advancing
               it; parm->sequential_file_pointer (R4) is ignored on
               entry.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_GBPB_Reason_GetMultipleBytesHere:
            /*
               parm->sequential_file_pointer (R4) gives the file
               offset to read from. Read parm->number (R3) bytes into
               parm->address (R2) from that offset.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_GBPB_Reason_GetMultipleBytes:
            /*
               Read parm->number (R3) bytes into parm->address (R2)
               from the file's current sequential pointer, advancing
               it; parm->sequential_file_pointer (R4) is ignored on
               entry.
             */
            err = err_DoesNothing;
            break;

        default:
            err = err_BadParameters;
            break;
    }

    return err;
}
