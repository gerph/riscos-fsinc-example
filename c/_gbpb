 ******************************************************************/

#ifndef __DUMMYFSDUMMYFS_H
#include "dummyfs.h"
#endif

/*******************************************************************
 Function:      fsentry_gbpb
 Description:   Transfer multiple bytes to or from an already-open
                file at an explicit offset, or at the file's current
                sequential pointer, selected by parm->reason. Only
                called when fsentry_open (c._open) reported unbuffered
                GBPB support in the returned information word.
 Parameters:    parm-> the parameters (see h.fsentries for details)
                    parm->handle (R1) identifies the open file, from
                                    fsentry_open, for every reason code
                    parm->address (R2) and parm->number (R3) give the
                                    buffer and byte count for every
                                    reason code; on exit, update them
                                    (and parm->sequential_file_pointer)
                                    to reflect the transfer actually
                                    made, with parm->number left
                                    holding the number of bytes not
                                    transferred (0 if the whole
                                    transfer completed)
 Returns:       pointer to error, or NULL if successful
 ******************************************************************/
_kernel_oserror *fsentry_gbpb(FSEntry_GBPB_Parameter * parm)
{
    _kernel_oserror *err;

    switch (parm->reason)
    {
        case FSEntry_GBPB_Reason_PutMultipleBytesHere:
            /* Write multiple bytes at a given file offset. If the
               offset lies beyond the file's current extent, fill the
               gap with zero bytes before writing the new data,
               extending the file as necessary.

               => parm->sequential_file_pointer-> file offset to
                                write at (R4)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12485
             */
            err = err_DoesNothing;
            break;

        case FSEntry_GBPB_Reason_PutMultipleBytes:
            /* As FSEntry_GBPB_Reason_PutMultipleBytesHere above, but
               at the file's current sequential pointer, advancing it,
               rather than an explicit offset.

               => parm->sequential_file_pointer (R4) is not given on
                                entry for this reason code

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12485
             */
            err = err_DoesNothing;
            break;

        case FSEntry_GBPB_Reason_GetMultipleBytesHere:
            /* Read multiple bytes from a given file offset. If the
               offset is at or beyond the file's current extent,
               transfer nothing: do not update the sequential
               pointer, and do not return an error (FileSwitch derives
               the C flag it reports to its own caller from whether
               parm->number is left non-zero, so no explicit EOF
               signalling is needed here).

               => parm->sequential_file_pointer-> file offset to
                                read from (R4)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12489
             */
            err = err_DoesNothing;
            break;

        case FSEntry_GBPB_Reason_GetMultipleBytes:
            /* As FSEntry_GBPB_Reason_GetMultipleBytesHere above, but
               at the file's current sequential pointer, advancing it,
               rather than an explicit offset.

               => parm->sequential_file_pointer (R4) is not given on
                                entry for this reason code

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12489
             */
            err = err_DoesNothing;
            break;

        default:
            err = err_BadParameters;
            break;
    }

    return err;
}
