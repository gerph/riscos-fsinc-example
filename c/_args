#ifndef __DUMMYFSDUMMYFS_h
#include "dummyfs.h"
#endif

/*******************************************************************
 Function:      fsentry_args
 Description:   Miscellaneous operations on an already-open file,
                selected by parm->reason.
 Parameters:    parm-> the parameters (see h.fsentries for details)
                    parm->handle (R1) identifies the open file, from
                                    fsentry_open (c._open), for every
                                    reason code
 Returns:       pointer to error, or NULL if successful
 ******************************************************************/
_kernel_oserror *fsentry_args(FSEntry_Args_Parameter * parm)
{
    _kernel_oserror *err;

    switch (parm->reason)
    {
        case FSEntry_Args_Reason_ReadSequentialFilePointer:
            /* Read the current sequential file pointer.

               => (only the common fields above)
               <= parm->arg.sequential_pointer (R2) = the byte offset
                                the next unbuffered/sequential
                                transfer would read from or write to
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_WriteSequentialFilePointer:
            /* Set the current sequential file pointer. Moving it
               past the current extent is valid and must not itself
               extend the file.

               => parm->arg.sequential_pointer-> new file pointer,
                                as a byte offset (R2)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_ReadFileExtent:
            /* Read the current extent (length) of the file.

               => (only the common fields above)
               <= parm->arg.extent (R2) = the file's current extent,
                                in bytes
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_WriteFileExtent:
            /* Set the extent (length) of the file: truncate if
               smaller than the current extent, or extend (ideally
               zero-filling the new space) if larger.

               => parm->arg.extent-> new extent, in bytes (R2)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_ReadSizeAllocatedToFile:
            /* Read the amount of storage allocated to the file,
               which may exceed its extent.

               => (only the common fields above)
               <= parm->arg.allocation_size (R2) = space allocated,
                                in bytes
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_EOFCheck:
            /* Test whether the sequential file pointer is at end of
               file.

               => (only the common fields above)
               <= parm->arg.EOF_Has_Been_Reached (R2) = Yes if the
                                sequential pointer is at or beyond the
                                file's extent, No otherwise
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_FlushFileBuffer:
            /* Flush any buffered output for this file to permanent
               storage; do nothing if there is nothing buffered.

               => (only the common fields above)
               <= (nothing)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_EnsureFileSize:
            /* Guarantee that at least the given amount of storage
               could be allocated to the file without failing,
               without actually changing the file's extent; a
               pre-flight check before a large write.

               => parm->arg.allocation_size-> storage required, in
                                bytes (R2)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_WriteZerosToFile:
            /* Write zero bytes into part of the file, extending it
               if required.

               => parm->arg.write_zeros.start-> byte offset to start
                                writing zeros at (R2)
                  parm->arg.write_zeros.number-> number of zero bytes
                                to write (R3)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Args_Reason_ReadFileDateStamp:
            /* Read the file's datestamp.

               => (only the common fields above)
               <= parm->arg.info (R2-R3) = the file's datestamp, as
                                an Information_Fields date_type pair
                                (see h.veneers)
             */
            err = err_DoesNothing;
            break;

        default:
            err = err_BadParameters;
            break;
    }

    return err;
}
