/*******************************************************************
 Function:      dummyfs_swi
 Description:   This is the SWI handler. Called by the module veneers
                 whenever one of DummyFS's SWIs is issued. There are
                 no module-specific SWIs declared in cmhg.modhead, so
                 this handler currently only exists to satisfy the
                 CMHG declaration; add a case per SWI offset within
                 the chunk as you declare SWIs of your own.
 Parameters:    swi_number = the SWI number within the module's chunk
                    (0 for the first SWI declared in cmhg.modhead)
                 r = pointer to the caller's registers, both on entry
                    and for the values to be returned
                 private_word = the module's private word, as passed
                    to dummyfs_initialise
 Returns:       NULL on success, otherwise a pointer to an error block
 ******************************************************************/
_kernel_oserror *dummyfs_swi(int swi_number, _kernel_swi_regs * r, void *private_word)
{
    _kernel_oserror *err = NULL;

    r = r;
    private_word = private_word;

    switch (swi_number)
    {
        default:
            err = err_DoesNothing;
            break;
    }

    return err;
}

/*******************************************************************
 Function:      dummyfs_finalise
 Description:   This is the finalisation code for DummyFS. Registered
                 with atexit() by dummyfs_initialise, and called by
                 the C library as the module dies, after the module's
                 SWI/service/command veneers have already been
                 disconnected. Removes the filing system from
                 FileSwitch, and should also free any memory or close
                 any connections the filing system is still holding.
 Parameters:    none
 Returns:       nothing
 ******************************************************************/
static void dummyfs_finalise(void)
{
    _kernel_swi_regs r;

    /*
       Close your filing system down here and free up all your memory NOW.
       If you do not then all your filing system's junk is going to be left
       cluttering up the RMA as this module is just about to be killed.
     */

    r.r[0] = FSControl_RemoveFilingSystem;
    r.r[1] = (int) FilingSystemName;

    _kernel_swi(XOS_Bit | OS_FSControl, &r, &r);
}

/*******************************************************************
 Function:      declare_dummyfs
 Description:   Declare DummyFS to FileSwitch, by building the 11-word
                 information block described in prminxml/fsinc.xml and
                 calling OS_FSControl 12 (FSControl_AddFilingSystem).
                 Called both from dummyfs_initialise, and again from
                 dummyfs_service whenever Service_FSRedeclare is
                 issued.
 Parameters:    private_word = the module's private word, passed
                    through to OS_FSControl so FileSwitch can hand it
                    back on every subsequent fsentry_* call
 Returns:       NULL on success, otherwise a pointer to the error
                    block returned by OS_FSControl (for example, if
                    the chosen filing system number is already in use)
 ******************************************************************/
static _kernel_oserror *declare_dummyfs(void *private_word)
{
    _kernel_swi_regs r;
    int information_block[Information_Block_Size];

    information_block[0] = (int) FilingSystemName - (int) Image__RO_Base;
    information_block[1] = (int) "DummyFS (Development version)" - (int) Image__RO_Base;
    information_block[2] = (int) &veneer_fsentry_open - (int) Image__RO_Base;
    information_block[3] = (int) &veneer_fsentry_getbytes - (int) Image__RO_Base;
    information_block[4] = (int) &veneer_fsentry_putbytes - (int) Image__RO_Base;
    information_block[5] = (int) &veneer_fsentry_args - (int) Image__RO_Base;
    information_block[6] = (int) &veneer_fsentry_close - (int) Image__RO_Base;
    information_block[7] = (int) &veneer_fsentry_file - (int) Image__RO_Base;
    information_block[8] = Information_Word;
    information_block[9] = (int) &veneer_fsentry_func - (int) Image__RO_Base;
    information_block[10] = (int) &veneer_fsentry_gbpb - (int) Image__RO_Base;

    r.r[0] = FSControl_AddFilingSystem;
    r.r[1] = (int) Image__RO_Base;
    r.r[2] = (int) information_block - (int) Image__RO_Base;
    r.r[3] = (int) private_word;

    return _kernel_swi(XOS_Bit | OS_FSControl, &r, &r);
}

/*******************************************************************
 Function:      dummyfs_initialise
 Description:   This is the initialisation code for DummyFS. Called
                 once, when the module is first loaded (or
                 reinitialised). Performs any of the filing system's
                 own start-up work, then declares the filing system
                 to FileSwitch and arranges for dummyfs_finalise to
                 run when the module dies.
 Parameters:    cmd_tail = the command line the module was started
                    with, unused by DummyFS
                 podule_base = podule hardware base address, unused
                    by DummyFS (not a podule-resident filing system)
                 private_word = pointer to the module's private word
 Returns:       NULL on success; a non-NULL return aborts module
                    initialisation and skips the FileSwitch
                    declaration (and thus dummyfs_finalise)
 ******************************************************************/
_kernel_oserror *dummyfs_initialise(const char *cmd_tail, int podule_base,
                                    void *private_word)
{
    _kernel_oserror *err;

    /*
       These keep the compiler quiet.
     */
    cmd_tail = cmd_tail;
    podule_base = podule_base;

    /*
       Place your filing system's initialisation here. If an error occurs then
       you can skip the 'declaring yourself to FileSwitch' bit.
     */

    err = declare_dummyfs(private_word);

    if (!err)
    {
        atexit(dummyfs_finalise);
    }

    return err;
}

/*******************************************************************
 Function:      dummyfs_service
 Description:   DummyFS service call handler. Called for every
                 service call listed against service-call-handler in
                 cmhg.modhead; currently only Service_FSRedeclare.
                 Add a case per additional service call as you
                 declare more of them.
 Parameters:    service_number = the service call number
                 r = pointer to the caller's registers; may be
                    examined or altered depending on the service call
                 private_word = the module's private word, as passed
                    to dummyfs_initialise
 Returns:       nothing; claim a service call, where the service
                    call's own convention requires it, by altering *r
                    rather than through a return value
 ******************************************************************/
void dummyfs_service(int service_number, _kernel_swi_regs * r, void *private_word)
{
    r = r;                      /* keep the compiler quiet */

    switch (service_number)
    {
        case Service_FSRedeclare:
            declare_dummyfs(private_word);
            break;

            /*
               Handle other service calls here
             */
    }
}

/*******************************************************************
 Function:      dummyfs_command
 Description:   DummyFS command processor. Called whenever one of the
                 star commands declared in the command-keyword-table
                 of cmhg.modhead is issued; currently only *DummyFS.
                 Add a case per additional command as you declare
                 more of them.
 Parameters:    arg_string = pointer to the command's argument text,
                    control-terminated, copied into
                    my_command_parameter_buffer and nul-terminated
                    before the switch below runs
                 argc = the number of arguments found in arg_string,
                    unused by DummyFS
                 cmd_no = the index, within the command-keyword-table,
                    of the command being processed (0 for *DummyFS)
                 private_word = the module's private word, as passed
                    to dummyfs_initialise
 Returns:       NULL on success, otherwise a pointer to an error block
 ******************************************************************/
_kernel_oserror *dummyfs_command(const char *arg_string, int argc,
                                 int cmd_no, void *private_word)
{
    _kernel_oserror *err = NULL;
    _kernel_swi_regs r;
    char *temptr = my_command_parameter_buffer;

    argc = argc;
    private_word = private_word;

    /*
       Change the control character terminator to a nul terminator
     */
    for (;
         temptr - my_command_parameter_buffer < My_Command_Parameter_Buffer_Len && *arg_string >= ASpace; arg_string++)
    {
        *(temptr++) = *arg_string;
    }

    *temptr = '\0';

    arg_string = my_command_parameter_buffer;

    /*
       Switch between the commands
     */
    switch (cmd_no)
    {
        case 0:
            /*
             *DummyFS
             */
            r.r[0] = FSControl_SelectFilingSystem;
            r.r[1] = (int) FilingSystemName;

            err = _kernel_swi(XOS_Bit | OS_FSControl, &r, &r);
            break;

        default:
            err = err_DoesNothing;
            break;
    }

    return err;
}
