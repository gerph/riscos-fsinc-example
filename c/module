#ifndef __DUMMYFSDUMMYFS_H
#include "dummyfs.h"
#endif

/*
        This is the SWI handler
*/
_kernel_oserror *dummyfs_swi(int swi_number, _kernel_swi_regs * r, void *private_word)
{
    _kernel_oserror *err = NULL;

    r = r;
    private_word = private_word;

    switch (swi_number)
    {
        default:
            err = err_DoesNothing;
            break;
    }

    return err;
}

/*
        This is the finalisation code for DummyFS
*/
static void dummyfs_finalise(void)
{
    _kernel_swi_regs r;

    /*
       Close your filing system down here and free up all your memory NOW.
       If you do not then all your filing system's junk is going to be left
       cluttering up the RMA as this module is just about to be killed.
     */

    r.r[0] = FSControl_RemoveFilingSystem;
    r.r[1] = (int) FilingSystemName;

    _kernel_swi(XOS_Bit | OS_FSControl, &r, &r);
}

/*
        Declare DummyFS to FileSwitch
*/
static _kernel_oserror *declare_dummyfs(void *private_word)
{
    _kernel_swi_regs r;
    int information_block[Information_Block_Size];

    information_block[0] = (int) FilingSystemName - (int) Image__RO_Base;
    information_block[1] = (int) "DummyFS (Development version)" - (int) Image__RO_Base;
    information_block[2] = (int) &veneer_fsentry_open - (int) Image__RO_Base;
    information_block[3] = (int) &veneer_fsentry_getbytes - (int) Image__RO_Base;
    information_block[4] = (int) &veneer_fsentry_putbytes - (int) Image__RO_Base;
    information_block[5] = (int) &veneer_fsentry_args - (int) Image__RO_Base;
    information_block[6] = (int) &veneer_fsentry_close - (int) Image__RO_Base;
    information_block[7] = (int) &veneer_fsentry_file - (int) Image__RO_Base;
    information_block[8] = Information_Word;
    information_block[9] = (int) &veneer_fsentry_func - (int) Image__RO_Base;
    information_block[10] = (int) &veneer_fsentry_gbpb - (int) Image__RO_Base;

    r.r[0] = FSControl_AddFilingSystem;
    r.r[1] = (int) Image__RO_Base;
    r.r[2] = (int) information_block - (int) Image__RO_Base;
    r.r[3] = (int) private_word;

    return _kernel_swi(XOS_Bit | OS_FSControl, &r, &r);
}

/*
        This is the initialisation code for DummyFS
*/
_kernel_oserror *dummyfs_initialise(const char *cmd_tail, int podule_base,
                                    void *private_word)
{
    _kernel_oserror *err;

    /*
       These keep the compiler quiet.
     */
    cmd_tail = cmd_tail;
    podule_base = podule_base;

    /*
       Place your filing system's initialisation here. If an error occurs then
       you can skip the 'declaring yourself to FileSwitch' bit.
     */

    err = declare_dummyfs(private_word);

    if (!err)
    {
        atexit(dummyfs_finalise);
    }

    return err;
}

/*
        DummyFS service call handler
*/
void dummyfs_service(int service_number, _kernel_swi_regs * r, void *private_word)
{
    r = r;                      /* keep the compiler quiet */

    switch (service_number)
    {
        case Service_FSRedeclare:
            declare_dummyfs(private_word);
            break;

            /*
               Handle other service calls here
             */
    }
}

/*
        DummyFS command processor
*/
_kernel_oserror *dummyfs_command(const char *arg_string, int argc,
                                 int cmd_no, void *private_word)
{
    _kernel_oserror *err = NULL;
    _kernel_swi_regs r;
    char *temptr = my_command_parameter_buffer;

    argc = argc;
    private_word = private_word;

    /*
       Change the control character terminator to a nul terminator
     */
    for (;
         temptr - my_command_parameter_buffer < My_Command_Parameter_Buffer_Len && *arg_string >= ASpace; arg_string++)
    {
        *(temptr++) = *arg_string;
    }

    *temptr = '\0';

    arg_string = my_command_parameter_buffer;

    /*
       Switch between the commands
     */
    switch (cmd_no)
    {
        case 0:
            /*
             *DummyFS
             */
            r.r[0] = FSControl_SelectFilingSystem;
            r.r[1] = (int) FilingSystemName;

            err = _kernel_swi(XOS_Bit | OS_FSControl, &r, &r);
            break;

        default:
            err = err_DoesNothing;
            break;
    }

    return err;
}
