/*
        Implementation of the FSEntry_File entry point. See the
        prologue for fsentry_file in h.fsentries for the parameters
        and return convention, and prminxml/fsinc.xml for the full
        description of each reason code.
*/

#ifndef __DUMMYFSDUMMYFS_H
#include "dummyfs.h"
#endif

/*
        Whole-object operations identified by pathname, selected by
        parm->reason. See h.fsentries for the parameter block layout.
        parm->name (R1) gives the object's pathname for every reason
        code below; parm->special_field (R6) points at any filing-
        system-specific text following it, or is NULL.
*/
_kernel_oserror *fsentry_file(FSEntry_File_Parameter * parm)
{
    _kernel_oserror *err;

    switch (parm->reason)
    {
        case FSEntry_File_Reason_LoadFile:
            /*
               parm->extras.location.start (R2) gives the address to
               load the file at (or a small negative pseudo-address
               requesting the file's own stamped load address).
               Read the whole file into memory there, then set:
                 parm->info (R2-R3) = the load/execute addresses the
                     file was stamped with
                 parm->extras.info.length (R4) = the file's length
                 parm->extras.info.attributes (R5) = the file's
                     attributes
                 parm->special_field (R6) = pointer to the object's
                     printable leafname
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_CreateFile:
            /*
               parm->info (R2-R3) gives load/execute addresses to
               stamp on the new file; the length to preallocate is
               given in the second word of parm->extras (R5) for this
               reason code, not parm->extras.info.length (R4), which
               is unused here. Create a new, empty file of that
               length. Set parm->special_field (R6) to the object's
               printable leafname.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_SaveFile:
            /*
               parm->info (R2-R3) gives load/execute addresses to
               stamp on the new file; parm->extras.location.start
               (R4) and .end (R5) bound the memory to save. Create
               the file from that memory block. Set
               parm->special_field (R6) to the object's printable
               leafname.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_WriteCatalogueInformation:
            /*
               Set the object's load address, execute address (both
               parm->info, R2-R3), length and attributes (both
               parm->extras.info, R4-R5) all together, to the values
               given.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_WriteLoadAddress:
            /*
               Set the object's load address to
               parm->info.load_exec.load_address (R2), leaving its
               execute address, length and attributes unchanged.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_WriteExecutionAddress:
            /*
               Set the object's execute address to
               parm->info.load_exec.execute_address (R3), leaving
               its load address, length and attributes unchanged.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_WriteAttributes:
            /*
               Set the object's access attributes to
               parm->extras.info.attributes (R5), leaving its load
               address, execute address and length unchanged.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_ReadCatalogueInformationNoLength:
            /*
               As ReadCatalogueInformation below, but
               parm->extras.info.length (R4) need not be filled in;
               only object type, load/execute addresses and
               attributes are required.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_ReadCatalogueInformation:
            /*
               Set parm->reason/return value in R0 to the object
               type (0 not found, 1 file, 2 directory, 3 both), and
               fill in parm->info (R2-R3), parm->extras.info.length
               (R4) and parm->extras.info.attributes (R5) from the
               object's catalogue entry.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_DeleteObject:
            /*
               Delete the object if it is a file, or an empty
               directory; fail if it is a non-empty directory. Set
               the object type in R0 (0 if it did not exist), and
               fill in parm->info (R2-R3), parm->extras.info.length
               (R4) and parm->extras.info.attributes (R5) with the
               values the object had immediately before deletion.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_File_Reason_CreateDirectory:
            /*
               parm->extras.info.length (R4) is a hint for the number
               of entries the directory should be sized for; ignore
               it if your filing system has no fixed-size
               directories. Create a new, empty directory at
               parm->name (R1).
             */
            err = err_DoesNothing;
            break;

        default:
            err = err_BadParameters;
            break;
    }

    return err;
}
