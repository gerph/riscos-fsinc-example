/*
        Implementation of the FSEntry_Open entry point. See the
        prologue for fsentry_open in h.fsentries for the parameters
        and return convention, and prminxml/fsinc.xml for the full
        description of each reason code.
*/

#ifndef __DUMMYFSDUMMYFS_H
#include "dummyfs.h"
#endif

/*
        Open a file, directory, or other object for access, selected
        by parm->open_definition.reason. See h.fsentries for the
        parameter block layout.
*/
_kernel_oserror *fsentry_open(FSEntry_Open_Parameter * parm)
{
    _kernel_oserror *err;

    switch (parm->open_definition.reason)
    {
        case FSEntry_Open_Reason_Update:
            /*
               Open an existing file for reading and writing (R0 = 2
               on entry). Read parm->open_definition.filename (R1)
               and fail if the object does not exist or is a
               directory. On success fill in parm->open_result:
                 R0 = information word (write/read/directory/
                      unbuffered-GBPB/interactive flags)
                 R1 = a non-zero FileSystemHandle you choose to
                      identify this open file on later calls
                 R2 = buffer size for buffered transfer (a power of
                      two, 64-1024), or 0 to use unbuffered
                      GetBytes/PutBytes
                 R3 = current file extent (only if R2 non-zero)
                 R4 = space allocated to the file (only if R2 non-zero)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Open_Reason_OpenRead:
            /*
               Open an existing file for reading only (R0 = 0 on
               entry). Read parm->open_definition.filename (R1) and
               fail if the object does not exist. Fill in
               parm->open_result exactly as for Update above, but
               with the write-permitted bit clear in R0.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Open_Reason_CreateUpdate:
            /*
               Create a new, empty file if parm->open_definition.
               filename (R1) does not already exist, or open the
               existing file unchanged if it does; either way, open
               it for reading and writing. Fill in parm->open_result
               exactly as for Update above.
             */
            err = err_DoesNothing;
            break;

        default:
            err = err_BadParameters;
            break;
    }

    return err;
}
