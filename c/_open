/*******************************************************************
 Function:      fsentry_open
 Description:   Open a file, directory, or other object for access,
                selected by parm->open_definition.reason.
 Parameters:    parm-> the parameters (see h.fsentries for details)
                    parm->open_definition.filename (R1) gives the
                                    object's pathname for every reason
                                    code
                    parm->open_definition.handle (R3) is the
                                    FileSwitch handle that will
                                    identify this open file elsewhere
                                    in the system
                    parm->open_definition.special_field (R6) points
                                    at any filing-system-specific text
                                    following the pathname, or is NULL
 Returns:       pointer to error, or NULL if successful
 ******************************************************************/
_kernel_oserror *fsentry_open(FSEntry_Open_Parameter * parm)
{
    _kernel_oserror *err;

    switch (parm->open_definition.reason)
    {
        case FSEntry_Open_Reason_Update:
            /* Open an existing file for reading and writing.

               => (only the common fields above)
               <= parm->open_result.information_word (R0) = write/
                                read/directory/unbuffered-GBPB/
                                interactive flags, see h.veneers
                  parm->open_result.handle (R1) = a non-zero
                                FileSystemHandle you choose to
                                identify this open file on later calls
                  parm->open_result.buffer_size (R2) = buffer size for
                                buffered transfer (a power of two,
                                64-1024), or 0 to use unbuffered
                                fsentry_getbytes/fsentry_putbytes
                                (c._getbytes, c._putbytes)
                  parm->open_result.file_extent (R3) = current file
                                extent (only if buffer_size non-zero)
                  parm->open_result.allocated_space (R4) = space
                                allocated to the file (only if
                                buffer_size non-zero)

               Fail if the object does not exist or is a directory.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Open_Reason_OpenRead:
            /* Open an existing file for reading only.

               => (only the common fields above)
               <= (as FSEntry_Open_Reason_Update above, but with the
                  write-permitted bit clear in
                  parm->open_result.information_word)

               Fail if the object does not exist.
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Open_Reason_CreateUpdate:
            /* Create a new, empty file if it does not already exist,
               or open the existing file unchanged if it does; either
               way, open it for reading and writing.

               => (only the common fields above)
               <= (as FSEntry_Open_Reason_Update above)
             */
            err = err_DoesNothing;
            break;

        default:
            err = err_BadParameters;
            break;
    }

    return err;
}
