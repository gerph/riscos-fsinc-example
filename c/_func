/*******************************************************************
 * File:        _func
 * Purpose:     Implementation of the FSEntry_Func entry point. See
 *              h.fsentries for where fsentry_func is declared, and
 *              prminxml/fsinc.xml for the full description of each
 *              reason code.
 * Author:      YOUR NAME HERE
 * Date:        08 Aug 2026
 ******************************************************************/

#ifndef __DUMMYFSDUMMYFS_H
#include "dummyfs.h"
#endif

/*******************************************************************
 Function:      fsentry_func
 Description:   Directory, path and filing-system-wide operations,
                selected by parm->reason. Many reason codes below are
                only called by RISC OS 2, or only called on later
                versions if a particular bit of the filing system
                information word (or its extra word) was set at
                initialisation; a minimal filing system targeting
                RISC OS 3 or later can leave those bits clear and
                decline the corresponding reason codes with
                err_BadParameters, provided it still supports reason
                codes 0, 7, 8, 9, 10, 14 and 16, which are always
                called.
 Parameters:    parm-> the parameters (see h.fsentries for details);
                    the meaning of each field depends on parm->reason,
                    see the individual cases below
 Returns:       pointer to error, or NULL if successful
 ******************************************************************/
_kernel_oserror *fsentry_func(FSEntry_Func_Parameter * parm)
{
    _kernel_oserror *err;

    switch (parm->reason)
    {
        case FSEntry_Func_Reason_SetCurrentDirectory:
            /* Set the current directory. Always called by RISC OS 2;
               on later versions, only called to implement *Opt 1
               when bit 23 of the filing system information word is
               clear. Do not also make the new directory the current
               context (in the sense of a logged-on server or
               similar) as part of this call - provide a separate
               mechanism for that, such as a *FS-style command.

               => parm->first_parameter.name_1-> new current
                                directory's pathname, possibly
                                wildcarded, or NULL to mean the user
                                root directory (R1)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12340
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_SetLibraryDirectory:
            /* Set the library directory. Only called by RISC OS 2.
               Do not also make the new directory the current
               context, for the same reason as
               FSEntry_Func_Reason_SetCurrentDirectory above.

               => parm->first_parameter.name_1-> new library
                                directory's pathname, possibly
                                wildcarded, or NULL to mean this
                                filing system's own default (R1)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12344
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_CatalogueDirectory:
            /* Produce a *Cat-style listing of a directory, written
               directly to the current output stream. Always called
               by RISC OS 2; on later versions, only called if bit 1
               of the extra filing system information word is set.

               => parm->first_parameter.name_1-> wildcarded directory
                                name, or NULL to mean the current
                                directory (R1)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12348
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ExamineCurrentDirectory:
            /* Produce a *Ex-style listing of a directory (full
               information on every object, not just names - compare
               FSEntry_Func_Reason_CatalogueDirectory above), written
               directly to the current output stream. Despite its
               name here, this is not a query for the current
               directory's own name - see
               FSEntry_Func_Reason_ReadCurrentDirectoryNameAndPrivilegeByte
               below for that. Always called by RISC OS 2; on later
               versions, only called if bit 2 of the extra filing
               system information word is set.

               => parm->first_parameter.name_1-> wildcarded directory
                                name, or NULL to mean the current
                                directory (R1)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12353
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_CatalogueLibraryDirectory:
            /* Produce a *LCat-style listing of a directory relative
               to the library directory, written directly to the
               current output stream. Always called by RISC OS 2; on
               later versions, only called if bit 1 of the extra
               filing system information word is set.

               => parm->first_parameter.name_1-> wildcarded directory
                                name relative to the library
                                directory, or NULL to mean the library
                                directory itself (R1)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12357
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ExamineLibraryDirectory:
            /* Produce a *LEx-style listing of a directory relative
               to the library directory, written directly to the
               current output stream. Despite its name here, this
               does not return the library directory's own name - see
               FSEntry_Func_Reason_ReadLibraryDirectoryNameAndPrivilegeByte
               below for that. Always called by RISC OS 2; on later
               versions, only called if bit 2 of the extra filing
               system information word is set.

               => parm->first_parameter.name_1-> wildcarded directory
                                name relative to the library
                                directory, or NULL to mean the library
                                directory itself (R1)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12362
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ExamineObjects:
            /* Produce a *Info-style listing for a set of objects,
               written directly to the current output stream, in the
               same format as FSEntry_Func_Reason_ExamineCurrentDirectory
               above. Always called by RISC OS 2; on later versions,
               only called if bit 2 of the extra filing system
               information word is set.

               => parm->first_parameter.name_1-> wildcarded pathname
                                (R1)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12366
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_SetFilingSystemOptions:
            /* Set filing-system-wide options; corresponds to *Opt.
               Option number 1 is never passed here, since FileSwitch
               maintains it itself; option number 4 sets the boot
               file action (see FSEntry_Func_Reason_BootFilingSystem
               below). Other option numbers are free for this filing
               system's own use, though a distinct allocation should
               be sought before shipping a real filing system using
               one. Return an error for a bad combination of option
               number and value.

               => parm->first_parameter.parameter-> the option number
                                to set, or 0 to reset every option to
                                its default value (R1)
                  parm->second_parameter.parameter-> the new value for
                                that option (R2)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12370
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_RenameObject:
            /* Rename or move an object, possibly with wildcards;
               corresponds to *Rename.

               => parm->first_parameter.name_1-> source pathname,
                                possibly wildcarded (R1)
                  parm->second_parameter.name_2-> destination
                                pathname (R2)
               <= parm->first_parameter.rename_invalid (R1) = 0 if the
                                rename was performed; non-zero if it
                                could not be done as a "simple" rename
                                (for example, because the two names
                                are on different discs) - FileSwitch
                                will then report "Bad rename" to the
                                caller itself

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12374
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_AccessObjects:
            /* Set access attributes on a set of objects, possibly
               with wildcards; corresponds to *Access. Ignore any
               owner-access bits that are not applicable to this
               filing system, but still try to store the
               public-access bits. Always called by RISC OS 2; on
               later versions, only called if bit 18 of the filing
               system information word is set.

               => parm->first_parameter.name_1-> wildcarded pathname
                                (R1)
                  parm->second_parameter.access_string-> access
                                attribute string, terminated by a
                                null, space, or control character (R2)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12378
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_BootFilingSystem:
            /* Perform *Opt 4-style boot handling for this filing
               system - for example, ADFS examines the boot option of
               the disc in the configured drive and acts on it, while
               NetFS attempts to log on as the configured boot user.
               This call may not return, if it ends up running an
               application.

               => (no arguments)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12382
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadNameAndBootOptionOfDisc:
            /* Read the name and boot option of the currently-
               selected medium. If there is no current medium (no
               CSD), return the name "Unset" and a boot option of 0.

               => parm->second_parameter.destination_address-> buffer
                                to receive the data; not pre-validated
                                by FileSwitch, since it does not know
                                how big the buffer needs to be -
                                validate it yourself, and return "No
                                writable memory at this address"
                                (RISC OS 2) or the token BadWrt (later
                                versions) if it is not usable. Do not
                                lock/interlock this memory while
                                writing to it (R2)
               <= (write a length-prefixed disc name, followed by a
                  boot option byte, into the buffer: one byte holding
                  the name's length, that many bytes of name, then the
                  boot option byte)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12386
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadCurrentDirectoryNameAndPrivilegeByte:
            /* Read the current directory's name together with its
               access privilege. Only called by RISC OS 2. If there
               is no current directory, return the name "Unset".

               => parm->second_parameter.destination_address-> buffer
                                to receive the data; not pre-validated
                                by FileSwitch - validate it yourself,
                                and return "No writable memory at this
                                address" if it is not usable (R2)
               <= (write a zero byte, then a length-prefixed current
                  directory name, then a privilege byte, into the
                  buffer: &00 if the caller has "owner" status in that
                  directory - may create and delete objects there -
                  or &FF for "public" status - may not. FileCore-based
                  filing systems always report owner status)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12390
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadLibraryDirectoryNameAndPrivilegeByte:
            /* Read the library directory's name together with its
               access privilege, in the same buffer format as
               FSEntry_Func_Reason_ReadCurrentDirectoryNameAndPrivilegeByte
               above. Only called by RISC OS 2. If there is no library
               directory selected, return the name "Unset".

               => parm->second_parameter.destination_address-> buffer
                                to receive the data; not pre-validated
                                by FileSwitch - validate it yourself,
                                and return "No writable memory at this
                                address" if it is not usable (R2)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12394
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadDirectoryEntries:
            /* Read a block of directory entry leafnames. Write the
               matching leafnames into the buffer as consecutive
               null-terminated strings; never overflow the buffer,
               and only count a name once it has been written in
               full. Because the buffer's validated length depends on
               whether the original call was OS_GBPB 8 (only [R3]
               10-character entries plus terminators are guaranteed
               valid) or OS_GBPB 9 (the whole R2/R5 range is valid),
               and a filing system cannot tell which was used, write
               conservatively as though only the smaller guarantee
               applies. It is valid to return zero entries with
               parm->read_offset = -1, both when the buffer was too
               small to hold even one entry, and when the previous
               call's last entry exactly reached the end of the
               directory. Return an error if the directory itself is
               not found, or is a file rather than a directory.

               => parm->first_parameter.name_1-> directory's pathname,
                                possibly wildcarded, or 0 for the
                                current directory (or the root
                                directory, for an image filing
                                system) (R1)
                  parm->second_parameter.destination_address->
                                buffer to receive leafnames (R2)
                  parm->third_parameter.read_number-> maximum entries
                                to return (R3)
                  parm->read_offset-> index of the first entry to
                                read, an opaque continuation value, 0
                                to start at the beginning (R4)
                  parm->buffer_length-> buffer length in bytes (R5)
               <= parm->third_parameter.read_number (R3) = number of
                                entries actually returned
                  parm->read_offset (R4) = the continuation value to
                                pass next time, or -1 if there are no
                                more entries

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12398
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadDirectoriesAndInformation:
            /* As FSEntry_Func_Reason_ReadDirectoryEntries above, but
               each buffer entry is a fixed-size, word-aligned record
               rather than a bare name:

                 offset  0  load address
                 offset  4  execution address
                 offset  8  length
                 offset 12  attributes
                 offset 16  object type (0 not found, 1 file, 2
                            directory)
                 offset 20  object name (null-terminated)

               Round the buffer pointer up to a word boundary before
               writing each record. This is the RISC OS 2/3 record
               layout; see FSEntry_Func_Reason_ReadDirectoryEntriesAndInformation
               below for the later, RISC OS 3+ layout used by
               OS_GBPB 9/10.

               => (as FSEntry_Func_Reason_ReadDirectoryEntries)
               <= (as FSEntry_Func_Reason_ReadDirectoryEntries)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12403
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ShutDown:
            /* Prepare for the machine to be shut down or reset: go
               into as dormant a state as possible, for example
               parking hard drive heads in their transit position.
               FileSwitch will already have closed every open file on
               this filing system before making this call.

               => (no arguments)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12407
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_PrintStartUpBanner:
            /* Print a start-up banner describing the current
               directory, for when this filing system is selected.
               Called on a reset service call when the filing
               system's title-string offset (word 1 of the filing
               system information block) is -1, so that the banner
               text can vary. Print the banner with an XOS_... SWI, so
               that any error it raises is reported normally (V set,
               R0 -> error block), though this is unlikely in
               practice.

               => (no arguments)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12412
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_SetDirectoryContexts:
            /* This reason code is defined but never actually issued
               by FileSwitch. Nothing needs implementing beyond
               falling through to the default case below.

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12415
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadDirectoryEntriesAndInformation:
            /* A revised, RISC OS 3-and-later form of
               FSEntry_Func_Reason_ReadDirectoriesAndInformation
               above, used for OS_GBPB reasons 9 and 10, with a
               differently-shaped word-aligned record:

                 offset  0  load address
                 offset  4  execution address
                 offset  8  length
                 offset 12  attributes
                 offset 16  object type (0 not found, 1 file, 2
                            directory)
                 offset 20  system internal name (for internal use
                            only)
                 offset 24  time/date, centiseconds since 1 Jan 1900,
                            or 0 if the object is not datestamped
                            (5 bytes)
                 offset 29  object name (null-terminated)

               => (as FSEntry_Func_Reason_ReadDirectoryEntries)
               <= (as FSEntry_Func_Reason_ReadDirectoryEntries)
                  See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12419
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_OutputFullInformationOnObjects:
            /* Produce a *FileInfo-style listing for a set of
               objects, written directly to the current output
               stream. Only called if bit 25 of the filing system
               information word was set at initialisation; otherwise
               FileSwitch synthesises the same output itself using
               repeated FSEntry_Func_Reason_ExamineObjects calls.

               => parm->first_parameter.name_1-> pathname, wildcarded
                                only under RISC OS 2 (R1)

               See: http://www.riscos.com/support/developers/prm/writefs.html#idx-12424
             */
            err = err_DoesNothing;
            break;

        default:
            err = err_BadParameters;
            break;
    }

    return err;
}
