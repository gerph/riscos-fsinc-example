 * File:        _func
 * Purpose:     Implementation of the FSEntry_Func entry point. See
 *              h.fsentries for where fsentry_func is declared, and
 *              prminxml/fsinc.xml for the full description of each
 *              reason code.
 * Author:      YOUR NAME HERE
 * Date:        07 Aug 2026
 ******************************************************************/

#ifndef __DUMMYFSDUMMYFS_H
#include "dummyfs.h"
#endif

/*******************************************************************
 Function:      fsentry_func
 Description:   Directory, path and filing-system-wide operations,
                selected by parm->reason. A minimal filing system can
                decline the more elaborate reason codes with
                err_BadParameters and still be usable, provided it
                supports at least setting/reading the current
                directory and cataloguing it.
 Parameters:    parm-> the parameters (see h.fsentries for details);
                    the meaning of each field depends on parm->reason,
                    see the individual cases below
 Returns:       pointer to error, or NULL if successful
 ******************************************************************/
_kernel_oserror *fsentry_func(FSEntry_Func_Parameter * parm)
{
    _kernel_oserror *err;

    switch (parm->reason)
    {
        case FSEntry_Func_Reason_SetCurrentDirectory:
            /* Set the current directory.

               => parm->first_parameter.name_1-> new current
                                directory's pathname (R1)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_SetLibraryDirectory:
            /* Set the library directory.

               => parm->first_parameter.name_1-> new library
                                directory's pathname (R1)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_CatalogueDirectory:
            /* Produce a *CAT-style listing of the current directory,
               written directly to the current output stream.

               => (no arguments)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ExamineCurrentDirectory:
            /* Return the name of the current directory.

               => (no arguments)
               <= parm->first_parameter.name_1 (R1) = pointer to the
                                current directory's pathname
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_CatalogueLibraryDirectory:
            /* Produce a *EX-style listing of the library directory,
               written directly to the current output stream.

               => (no arguments)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ExamineLibraryDirectory:
            /* Return the name of the library directory.

               => (no arguments)
               <= parm->first_parameter.name_1 (R1) = pointer to the
                                library directory's pathname
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ExamineObjects:
            /* Wildcard-examine a set of objects.

               => parm->first_parameter.name_1-> wildcarded pathname
                                (R1)
                  parm->second_parameter.destination_address->
                                buffer to receive matching leafnames
                                (R2)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_SetFilingSystemOptions:
            /* Set filing-system-wide options.

               => parm->second_parameter.access_string-> option
                                string, in the same style as this
                                filing system's own configuration
                                star command (R2)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_RenameObject:
            /* Rename or move an object, possibly with wildcards.

               => parm->first_parameter.name_1-> source pathname,
                                possibly wildcarded (R1)
                  parm->second_parameter.name_2-> destination
                                pathname (R2)
               <= parm->first_parameter.rename_invalid (R1) = Yes if
                                the rename cannot be performed (for
                                example, renaming a directory into
                                itself)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_AccessObjects:
            /* Set access attributes on a set of objects, possibly
               with wildcards.

               => parm->first_parameter.name_1-> wildcarded pathname
                                (R1)
                  parm->second_parameter.access_string-> access
                                attribute string to apply (R2)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_BootFilingSystem:
            /* Perform *OPT4-style boot handling for this filing
               system (for example, running a boot file from the
               root of the currently-selected medium).

               => (no arguments)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadNameAndBootOptionOfDisc:
            /* Read the name and boot option of the currently-
               selected medium.

               => (no arguments)
               <= parm->second_parameter.destination_address (R2) =
                                pointer to the medium's name
                  parm->third_parameter.read_number (R3) = its boot
                                option number
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadCurrentDirectoryNameAndPrivilegeByte:
            /* Read the current directory's name together with its
               access privilege.

               => (no arguments)
               <= parm->first_parameter.name_1 (R1) = pointer to the
                                current directory's pathname
                  parm->second_parameter.parameter (R2) = its
                                privilege byte
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadLibraryDirectoryNameAndPrivilegeByte:
            /* Read the library directory's name together with its
               access privilege.

               => (no arguments)
               <= parm->first_parameter.name_1 (R1) = pointer to the
                                library directory's pathname
                  parm->second_parameter.parameter (R2) = its
                                privilege byte
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadDirectoryEntries:
            /* Read a block of directory entry leafnames.

               => parm->first_parameter.name_1-> directory's pathname,
                                or 0 for the current directory (R1)
                  parm->second_parameter.destination_address->
                                buffer to receive leafnames (R2)
                  parm->third_parameter.read_number-> maximum entries
                                to return (R3)
                  parm->read_offset-> index of the first entry to
                                read, an opaque continuation value
                                (R4)
                  parm->buffer_length-> buffer length in bytes (R5)
               <= parm->third_parameter.read_number (R3) = number of
                                entries actually returned
                  parm->read_offset (R4) = the continuation value to
                                pass next time, or -1 if there are no
                                more entries
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadDirectoriesAndInformation:
            /* As FSEntry_Func_Reason_ReadDirectoryEntries above, but
               the buffer at
               parm->second_parameter.destination_address (R2) must
               also be filled with each entry's catalogue information
               (load/execute addresses, length, attributes) alongside
               its leafname.

               => (as FSEntry_Func_Reason_ReadDirectoryEntries)
               <= (as FSEntry_Func_Reason_ReadDirectoryEntries)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ShutDown:
            /* Prepare for the machine to be shut down or reset:
               flush any buffered data for every open file and close
               down any outstanding connections to the underlying
               medium, since the machine may be powered off
               immediately after this call returns.

               => (no arguments)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_PrintStartUpBanner:
            /* Print a start-up banner describing the current
               directory, for when this filing system is selected
               with its star command.

               => (no arguments)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_SetDirectoryContexts:
            /* Set the current, library and other directory contexts
               together; see prminxml/fsinc.xml for the parameter
               layout for this reason code.

               => (see prminxml/fsinc.xml)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_ReadDirectoryEntriesAndInformation:
            /* A RISC OS 3-style revision of
               FSEntry_Func_Reason_ReadDirectoriesAndInformation
               above, with a differently-shaped output buffer, used
               by OS_GBPB reasons 9 and 10.

               => (as FSEntry_Func_Reason_ReadDirectoryEntries)
               <= (as FSEntry_Func_Reason_ReadDirectoryEntries)
             */
            err = err_DoesNothing;
            break;

        case FSEntry_Func_Reason_OutputFullInformationOnObjects:
            /* Produce a *EX-style full information listing for a
               set of objects, written directly to the current
               output stream.

               => parm->first_parameter.name_1-> wildcarded pathname
                                (R1)
             */
            err = err_DoesNothing;
            break;

        default:
            err = err_BadParameters;
            break;
    }

    return err;
}
