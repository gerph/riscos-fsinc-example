/*******************************************************************
 Function:      fsentry_putbytes
 Description:   Write one byte, or a block of bytes, to an open
                file. As with fsentry_getbytes (c._getbytes), there
                is no reason code; FileSwitch calls this in one of
                two ways, matching the mode chosen when the file was
                opened by fsentry_open (c._open).

                Unbuffered (single byte) transfer:

                => parm->byte_to_put-> the byte to write, low 8 bits
                                (R0)
                   parm->handle-> the FileSystemHandle from
                                fsentry_open (R1)
                <= (nothing; the byte is written at the file's current
                   sequential pointer, which advances by one,
                   extending the file if the pointer was at its end)

                Buffered transfer:

                => parm->handle-> the FileSystemHandle from
                                fsentry_open (R1)
                   parm->source_start-> buffer to write from (R2)
                   parm->bytes_to_write-> number of bytes to write
                                (R3)
                   parm->file_offset_to_put_data_to-> file offset to
                                write to (R4)
                <= (nothing; extend the file if the write goes past
                   its current extent)

                Either way, fail with a "disc full" style error
                (matching the pattern used by other filing systems,
                see doc.FSinC and prminxml/fsinc.xml) if there is not
                enough free space to extend the file as required.
 Parameters:    parm-> the parameters (see h.fsentries for details)
 Returns:       pointer to error, or NULL if successful
 ******************************************************************/
_kernel_oserror *fsentry_putbytes(FSEntry_PutBytes_Parameter * parm)
{
    _kernel_oserror *err;

    err = err_DoesNothing;

    return err;
}
